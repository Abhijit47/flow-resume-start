{
  "name": "flow-resume-start",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "generate-routes": "tsr generate",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint",
    "format": "prettier --write . && eslint --fix",
    "check": "prettier --check .",
    "post-cta-init": "pnpm dlx create-db@latest --user-agent tanstack/tsrouter",
    "db:migrate": "dotenv -e .env.local -- prisma migrate dev",
    "db:generate": "dotenv -e .env.local -- prisma generate",
    "db:push": "dotenv -e .env.local -- prisma db push",
    "db:pull": "dotenv -e .env pnpx prisma db pull",
    "db:studio": "dotenv -e .env.local -- prisma studio",
    "db:seed": "dotenv -e .env.local -- prisma db seed",
    "db:reset": "dotenv -e .env.local -- pnpx prisma migrate reset",
    "db:dev": "pnpm db:push && pnpm db:generate",
    "auth:gen": "pnpm dlx auth@latest generate --config \"./src/lib/auth.ts\" --output \"./src/lib/auth-generated.prisma\" --yes"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@better-auth/prisma-adapter": "^1.6.25",
    "@dnd-kit/core": "^6.3.1",
